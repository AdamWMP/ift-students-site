generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model Location {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  region    String
  address   String
  schedules Schedule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Schedule {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  duration    String
  icon        String
  times       String
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  startDates  StartDate[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StartDate {
  id         String   @id @default(cuid())
  date       DateTime
  spotsLeft  Int      @default(12)
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  bookings   Booking[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Package {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  price       Float
  fundedPrice Float?
  description String?
  features    String?
  popular     Boolean  @default(false)
  bookings    Booking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tutor {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?
  imageUrl  String?
  location  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id                  String   @id @default(cuid())
  firstName           String
  lastName            String
  email               String
  phone               String
  packageId           String
  package             Package  @relation(fields: [packageId], references: [id])
  startDateId         String
  startDate           StartDate @relation(fields: [startDateId], references: [id])
  depositAmount       Float
  totalAmount         Float
  remainingBalance    Float
  monthlyPayment      Float
  paymentMonths       Int      @default(12)
  stripeCustomerId    String?
  stripeSubscriptionId String?
  paymentStatus       String   @default("pending")
  paymentsCompleted   Int      @default(0)
  ontraportContactId  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  course    String
  content   String
  imageUrl  String?
  rating    Int      @default(5)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Receipt billing history ─────────────────────────────────────────
// Every receipt emailed/WhatsApp'd to a student is logged here. Adam's
// admin view (/admin/receipts) queries this table for the full billing
// history per student + financial reconciliation. Receipts are written
// in sendReceipt() — non-blocking on the checkout response.
model Receipt {
  // receiptNo is the human-readable invoice number, e.g. "IFT-2026-108318"
  receiptNo         String   @id
  contactId         String                       // Ontraport contact id = student no.
  brand             String   @default("ift")     // 'ift' | 'pilates'
  firstName         String
  lastName          String
  email             String
  phone             String
  packageName       String
  intakeDate        String                       // human-readable
  location          String
  schedule          String
  courseTotal       Float
  paidToday         Float
  remainingBalance  Float
  monthlyAmount     Float
  months            Int                          @default(0)
  firstInstalment   String                       // e.g. "30 June 2026" (empty if paid in full)
  cardLast4         String?
  isFullPayment     Boolean
  // Channel delivery status — set at send time
  emailSent         Boolean  @default(false)
  emailError        String?
  whatsappSent      Boolean  @default(false)
  whatsappError     String?
  // Stored HTML snapshot — exactly what the customer received
  htmlSnapshot      String                       // SQLite TEXT, no size limit
  // Cross-reference
  ontraportInvoiceId String?
  createdAt         DateTime @default(now())

  @@index([contactId])
  @@index([email])
  @@index([createdAt])
}
